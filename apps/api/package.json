{
  "name": "@platform/api",
  "private": true,
  "scripts": {
    "dev": "nest start --watch --builder webpack --webpackPath webpack.config.js",
    "build": "pnpm --workspace-root prisma:generate && nest build --builder webpack --webpackPath webpack.config.js",
    "start": "node dist/main.js",
    "lint": "eslint \"src/**/*.ts\"",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@langchain/langgraph": "^1.4.14",
    "@nestjs/common": "11.1.28",
    "@nestjs/config": "4.0.4",
    "@nestjs/core": "11.1.28",
    "@nestjs/jwt": "11.0.2",
    "@nestjs/platform-express": "11.1.28",
    "@nestjs/swagger": "11.4.6",
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "7.9.1",
    "bullmq": "5.81.2",
    "class-transformer": "0.5.1",
    "class-validator": "0.15.1",
    "firebase-admin": "14.2.0",
    "helmet": "8.3.0",
    "ioredis": "5.11.1",
    "mammoth": "^1.12.2",
    "pdf-parse": "^2.4.5",
    "pg": "^8.23.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@nestjs/cli": "11.0.24",
    "@types/express": "5.0.6",
    "@types/node": "24.13.3",
    "@typescript-eslint/eslint-plugin": "^8.70.0",
    "@typescript-eslint/parser": "^8.70.0",
    "globals": "^17.12.0",
    "jszip": "^3.10.2",
    "prisma": "7.9.1",
    "ts-loader": "^9.6.2",
    "tsconfig-paths-webpack-plugin": "^4.2.0",
    "typescript": "^6.0.0",
    "vitest": "^5.0.0"
  }
